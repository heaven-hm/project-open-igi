# Explicit, fail-closed native checks. Diagnostic executable builds remain independent.
include_guard(GLOBAL)
find_package(Python3 3.10 REQUIRED COMPONENTS Interpreter)
set(IGI_NATIVE_TEST_ADDRESSES "" CACHE STRING "Semicolon-separated retail addresses; empty uses selected source scope")
set(IGI_NATIVE_TEST_SCOPE "compiled" CACHE STRING "compiled, changed or engine native source scope")
set_property(CACHE IGI_NATIVE_TEST_SCOPE PROPERTY STRINGS compiled changed engine)
set(IGI_NATIVE_TEST_PROBE "" CACHE FILEPATH "Reviewed typed probe; missing probe blocks runtime tests")
set(IGI_NATIVE_TEST_PROBE_MAP "" CACHE FILEPATH "Optional JSON address-to-reviewed-probe mapping")
set(IGI_NATIVE_TEST_LEVEL "1" CACHE STRING "Retail level for paired scenarios")
if(TARGET igi)
    set(_igi_candidate "$<TARGET_FILE:igi>")
    set(_igi_candidate_build "${CMAKE_BINARY_DIR}")
else()
    set(IGI_NATIVE_CANDIDATE "${CMAKE_SOURCE_DIR}/build-win32-no-verify-gate/igi1.exe" CACHE FILEPATH "Configured x86 candidate output")
    set(IGI_NATIVE_CANDIDATE_BUILD "${CMAKE_SOURCE_DIR}/build-win32-no-verify-gate" CACHE PATH "Configured x86 candidate build tree")
    set(_igi_candidate "${IGI_NATIVE_CANDIDATE}")
    set(_igi_candidate_build "${IGI_NATIVE_CANDIDATE_BUILD}")
endif()
set(_igi_receipt "${CMAKE_BINARY_DIR}/native-ctest-candidate-receipt.json")
set(_igi_bridge "${CMAKE_SOURCE_DIR}/scripts/native_ctest.py")
set(_igi_scope --root "${CMAKE_SOURCE_DIR}" --scope "${IGI_NATIVE_TEST_SCOPE}" --output "${CMAKE_BINARY_DIR}/native-ctest")
foreach(_address IN LISTS IGI_NATIVE_TEST_ADDRESSES)
    list(APPEND _igi_scope --address "${_address}")
endforeach()
if(IGI_NATIVE_TEST_SCOPE STREQUAL "compiled" AND TARGET igi)
    get_target_property(_igi_sources igi SOURCES)
    foreach(_source IN LISTS _igi_sources)
        if(_source MATCHES "^[$]<TARGET_OBJECTS:([^>]+)>$")
            set(_igi_object_target "${CMAKE_MATCH_1}")
            get_target_property(_igi_object_sources "${_igi_object_target}" SOURCES)
            foreach(_object_source IN LISTS _igi_object_sources)
                list(APPEND _igi_scope --source "${_object_source}")
            endforeach()
        else()
            list(APPEND _igi_scope --source "${_source}")
        endif()
    endforeach()
    get_target_property(_igi_build_dependencies igi MANUALLY_ADDED_DEPENDENCIES)
    foreach(_dependency IN LISTS _igi_build_dependencies)
        if(TARGET "${_dependency}")
            get_target_property(_dependency_type "${_dependency}" TYPE)
            if(_dependency_type STREQUAL "OBJECT_LIBRARY")
                get_target_property(_dependency_sources "${_dependency}" SOURCES)
                foreach(_dependency_source IN LISTS _dependency_sources)
                    list(APPEND _igi_scope --compile-only-source "${_dependency_source}")
                endforeach()
            endif()
        endif()
    endforeach()
endif()
set(_igi_runtime --candidate "${_igi_candidate}" --receipt "${_igi_receipt}" --build-dir "${_igi_candidate_build}" --level "${IGI_NATIVE_TEST_LEVEL}")
if(IGI_NATIVE_TEST_PROBE_MAP)
    list(APPEND _igi_runtime --probe-map "${IGI_NATIVE_TEST_PROBE_MAP}")
endif()
if(IGI_NATIVE_TEST_PROBE)
    list(APPEND _igi_runtime --probe "${IGI_NATIVE_TEST_PROBE}")
endif()
add_custom_target(verify-native-static
    COMMAND "${Python3_EXECUTABLE}" "${_igi_bridge}" static ${_igi_scope}
    USES_TERMINAL VERBATIM)
add_custom_target(verify-native-runtime
    COMMAND "${Python3_EXECUTABLE}" "${_igi_bridge}" prepare ${_igi_scope} ${_igi_runtime}
    COMMAND "${Python3_EXECUTABLE}" "${_igi_bridge}" runtime ${_igi_scope} ${_igi_runtime}
    USES_TERMINAL VERBATIM)
if(BUILD_TESTING)
    add_test(NAME igi.verification.infrastructure
        COMMAND "${Python3_EXECUTABLE}" "${CMAKE_SOURCE_DIR}/scripts/test_native_ctest.py")
    set_tests_properties(igi.verification.infrastructure PROPERTIES LABELS "infrastructure" TIMEOUT 60)
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${_igi_bridge}" list ${_igi_scope}
        OUTPUT_VARIABLE _igi_inventory RESULT_VARIABLE _igi_list_result ERROR_VARIABLE _igi_list_error)
    set(_igi_expected "${CMAKE_BINARY_DIR}/native-ctest-scope.json")
    if(_igi_list_result EQUAL 0)
        file(WRITE "${_igi_expected}" "${_igi_inventory}\n")
    endif()
    add_test(NAME igi.native.scope
        COMMAND "${Python3_EXECUTABLE}" "${_igi_bridge}" scope ${_igi_scope} --expected-scope "${_igi_expected}")
    set_tests_properties(igi.native.scope PROPERTIES LABELS "native;scope" FIXTURES_SETUP igi_scope TIMEOUT 60)
    if(_igi_list_result EQUAL 0)
        string(JSON _igi_count LENGTH "${_igi_inventory}" natives)
        if(_igi_count GREATER 0)
            add_test(NAME igi.native.candidate
                COMMAND "${Python3_EXECUTABLE}" "${_igi_bridge}" prepare ${_igi_scope} ${_igi_runtime} --expected-scope "${_igi_expected}")
            set_tests_properties(igi.native.candidate PROPERTIES LABELS "native;runtime;fixture"
                FIXTURES_REQUIRED igi_scope FIXTURES_SETUP igi_candidate RUN_SERIAL TRUE TIMEOUT 2400)
            math(EXPR _igi_last "${_igi_count}-1")
            foreach(_index RANGE ${_igi_last})
                string(JSON _igi_address GET "${_igi_inventory}" natives ${_index} address)
                set(_igi_single --root "${CMAKE_SOURCE_DIR}" --address "${_igi_address}" --output "${CMAKE_BINARY_DIR}/native-ctest" --expected-scope "${_igi_expected}")
                add_test(NAME "igi.native.static.${_igi_address}"
                    COMMAND "${Python3_EXECUTABLE}" "${_igi_bridge}" static ${_igi_single})
                set_tests_properties("igi.native.static.${_igi_address}" PROPERTIES LABELS "native;static"
                    FIXTURES_REQUIRED igi_scope FIXTURES_SETUP "igi_static_${_igi_address}" RUN_SERIAL TRUE TIMEOUT 2100)
                add_test(NAME "igi.native.runtime.${_igi_address}"
                    COMMAND "${Python3_EXECUTABLE}" "${_igi_bridge}" runtime ${_igi_single} ${_igi_runtime})
                set_tests_properties("igi.native.runtime.${_igi_address}" PROPERTIES LABELS "native;runtime"
                    FIXTURES_REQUIRED "igi_scope;igi_candidate;igi_static_${_igi_address}"
                    RUN_SERIAL TRUE RESOURCE_LOCK igi_runtime TIMEOUT 2400)
            endforeach()
            message(STATUS "Registered static/runtime checks for ${_igi_count} selected natives; runtime requires a reviewed probe and valid receipt.")
        endif()
    else()
        message(STATUS "Native selection is blocked: ${_igi_list_error}. igi.native.scope will fail, not silently skip.")
    endif()
endif()
