#!/usr/bin/env bash
# Owner's later instruction: automatically test newly added/edited natives.
# Staged sources must equal the working sources tested by the verifier.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
exec python3 "$root/scripts/native_autoverify.py" run \
    --scope "${IGI_NATIVE_COMMIT_SCOPE:-staged}" \
    --level "${IGI_NATIVE_TEST_LEVEL:-1}" --retry
