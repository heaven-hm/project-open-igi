# Only the engine sources are tracked.
#
# Everything else in the tree is local output, reference material or tooling
# that the verification workflow regenerates. Files that are already tracked
# stay tracked; this only keeps new material out of the index.
/*
!/engine/
!/.gitignore
!/.githooks/
*.pyc
__pycache__
.pyc
*.pyc
scripts/__pycache__
scripts/*.pyc

# The native transcriptions are the source of the port, so the renamed files
# have to stay trackable even though the rest of scripts/ is not.
/scripts/
!/scripts/GameNatives/
!/scripts/GameNatives/**

# Build output and object files.
build/
build-*/
build_*/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
*.o
*.obj
*.a
*.dll
*.dylib
*.pdb
*.ilk
*.exp

# Fidelity records are tracked: they are the per-native evidence and the
# manifest. Everything else under docs/ stays local. Without this, `git add -A`
# silently skips evidence changes on modified-but-ignored paths.
!/docs/
/docs/*
!/docs/fidelity/
!/docs/fidelity/**

scripts/__pycache__/build_attestation.cpython-312.pyc
scripts/__pycache__/candidate_build_receipt.cpython-312.pyc
scripts/__pycache__/frida_capture_lease.cpython-312.pyc
scripts/__pycache__/frida_dynobj_link_dynamic_cube_pair.cpython-312.pyc
scripts/__pycache__/native_gate.cpython-312.pyc
scripts/__pycache__/smart_end_to_end_verification.cpython-312.pyc
scripts/__pycache__/verification_scope.cpython-312.pyc
scripts/__pycache__/verify_v4_catalog.cpython-312.pyc
*.pyc