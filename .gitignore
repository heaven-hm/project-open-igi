# Only the engine sources are tracked.
#
# Everything else in the tree is local output, reference material or tooling
# that the verification workflow regenerates. Files that are already tracked
# stay tracked; this only keeps new material out of the index.
/*
!/engine/
!/.gitignore

# The native transcriptions are the source of the port, so the renamed files
# have to stay trackable even though the rest of scripts/ is not.
/scripts/
!/scripts/GameNatives/
!/scripts/GameNatives/**

# Build output and object files.
build/
build-*/
build_*/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
*.o
*.obj
*.a
*.dll
*.dylib
*.pdb
*.ilk
*.exp
